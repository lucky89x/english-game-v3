  "grammar": [
    "verbs of liking + V-ing or to V: love, like, prefer, hate (both forms); enjoy, fancy, adore, dislike, detest, don't mind (V-ing only)",
    "expressions about hobbies: be keen on, be a fan of, be interested in, be hooked on, be addicted to (like); be obsessed with, be mad about, be crazy about (love); be bad at, be terrible at (dislike)"
  ],
  "activities": {
    "lost_letter": {
      "skill": "reading",
      "difficulty": "advanced",
      "letter": "Dear Mr Tom,\n\nIn my leisure time I love fishing by the river and I am keen on making small wooden boats. Last week I lost my favourite fishing net near the old bridge. My grandson prefers doing DIY, so he wants to make me a new one, but I still miss the old net.\n\nCould you ask the villagers to keep an eye out for it?\n\nBest wishes,\nSam",
      "question": "What does Sam want Mr Tom to do?",
      "choices": [
        "Buy him a new boat",
        "Ask the villagers to look for his net",
        "Teach his grandson DIY"
      ],
      "answer": 1,
      "hint": "Tìm câu hỏi nhờ vả ở cuối thư: \"Could you ask the villagers to ...?\""
    }
  },
